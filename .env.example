# Database. Leave unset locally to use a SQLite file in DATA_DIR.
# On Vercel, use the libsql:// URL and token from Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional. Takes priority over TURSO_*, for when an integration gives each deployment its own database.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Where the local SQLite file and generated secret live (local and Docker only).
DATA_DIR=./data

# Admin password. Required on Vercel. Locally, first-run setup asks for one if unset.
ADMIN_PASSWORD=

# Encrypts stored source credentials. Required on Vercel. Locally, a key is generated in DATA_DIR/secret.key if unset.
# Changing it makes existing source credentials unreadable.
SECRET_KEY=

# Protects /api/cron. Required on Vercel.
CRON_SECRET=

# Public URL of the app. Needed behind a reverse proxy (not on Vercel).
ORIGIN=http://localhost:3000

SYNC_INTERVAL_MINUTES=360

# Sample-data sources are always available in dev. Set to true to allow them in production.
ENABLE_MOCK_SOURCES=false

# Optional. TMDB API read access token (Bearer token) for streaming availability lookups.
TMDB_READ_TOKEN=

# Two-letter country code used for streaming availability.
STREAMING_REGION=US
