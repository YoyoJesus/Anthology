# Where the SQLite database, poster cache and generated secret live.
DATA_DIR=./data

# Optional. When set, this is the admin password and first-run setup is skipped.
ADMIN_PASSWORD=

# Encrypts stored source credentials. If unset, a key is generated in DATA_DIR/secret.key.
# Changing it makes existing source credentials unreadable.
SECRET_KEY=

# Public URL of the app. Required in production behind a proxy.
ORIGIN=http://localhost:3000

POSTER_CACHE_MAX_MB=500
SYNC_INTERVAL_MINUTES=360

# Sample-data sources are always available in dev. Set to true to allow them in production.
ENABLE_MOCK_SOURCES=false

# Optional. TMDB API read access token (Bearer token) for streaming availability lookups.
TMDB_READ_TOKEN=

# Two-letter country code used for streaming availability.
STREAMING_REGION=US
